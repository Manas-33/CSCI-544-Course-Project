# Allow-list: ignore everything at the top level, then track only the files below.
# The proposal, instructor feedback and review/working files stay local on purpose.
/*
!/bank/
!/.gitignore
!/.gitattributes
!/PLAN.md
!/PROJECT.md
!/NEXT_STEPS.md

# AR+AR component only; runtime outputs/caches remain outside the allow-list.
!/requirements.txt
!/requirements-analysis.txt
!/harness/
/harness/*
!/harness/*.py
!/harness/README.md
!/configs/
/configs/*
!/configs/*.json

# Track AR verifier experiment results
!/results/
/results/*

# BF16 experiments
!/results/bf16/
/results/bf16/*
!/results/bf16/ar-sanity-bf16-20261020-015535/
!/results/bf16/ar-sanity-analysis-bf16-20261020-015535/

# FP32 experiments
!/results/fp32/
/results/fp32/*
!/results/fp32/ar-sanity-analysis/
!/results/fp32/ar-sanity-nf4-fp32/

# PPT-ready result package
!/results/ppt_ar_sanity/
!/results/ppt_ar_sanity/*

# Never track these, even inside allowed folders
.DS_Store
.Rhistory

# Verified unquantized BF16 runs using SDPA attention.
!/results/bf16/sdpa/
/results/bf16/sdpa/*
!/results/bf16/sdpa/ar-sanity-bf16-sdpa-20261026-000459/
!/results/bf16/sdpa/ar-sanity-analysis-bf16-sdpa-20261026-000459/

# Team decisions and deviations from PLAN.md (PLAN §7, §10, §11)
!/decisions/

# Colab notebooks and the stage-3 model runs they produce
!/notebooks/
!/results/stage3/

# Diffusion adapters and LLaDA comparison assets
!/harness/diffusion/
!/results/llada-comparison-20261019-213107/

__pycache__/
*.pyc
.pytest_cache/
